AI_GATEWAY_API_KEY=

# Tuya Cloud (LSC Indoor IP Camera) – Werte aus iot.tuya.com / platform.tuya.com
# Cloud-Projekt -> Authorization Key
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Datacenter der Region: eu | us | cn | in
TUYA_REGION=eu
# Device-ID der Kamera (Cloud -> Devices -> Kamera -> Device ID)
# Falls leer: /api/stallwache/devices aufrufen, um die ID zu finden.
TUYA_DEVICE_ID=
# User-ID (Cloud -> Devices -> Linked App Account). Aktiviert den
# /v1.0/users/{uid}/devices/.../allocate-Endpunkt. Bei Smart-Home-verknüpften
# Geräten zwingend nötig – der device-only-Endpunkt liefert sonst 1106/permission deny.
TUYA_USER_ID=
